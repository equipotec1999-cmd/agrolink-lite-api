<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Las pruebas usan SIEMPRE una base propia (RefreshDatabase la borra y recrea):
             nunca la de desarrollo ni la de producción. TestCase se niega a correr si el
             nombre no termina en _test. Host/usuario/clave se pueden cambiar por variables de entorno. -->
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="DB_DATABASE" value="agrolink_test" force="true"/>
        <env name="DB_SEARCH_PATH" value="public" force="true"/>
        <env name="DB_SSLMODE" value="prefer" force="true"/>
        <env name="EMAIL_VERIFICATION_REQUIRED" value="true" force="true"/>
        <env name="FIREBASE_CREDENTIALS_BASE64" value="" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
