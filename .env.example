APP_NAME=AgroLink
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=agrolink
DB_USERNAME=postgres
DB_PASSWORD=
# Producción (Supabase): DB_SSLMODE=require y DB_SEARCH_PATH=public,extensions
DB_SSLMODE=prefer
DB_SEARCH_PATH=public

# Sanctum: dominios del front (Flutter Web) que pueden usar cookies de sesión.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Almacenamiento (Fase 1 §16-18): Cloudflare R2 recomendado por costo de egreso $0
# frente a S3; el driver flysystem-aws-s3-v3 funciona igual apuntando al endpoint de R2.
FILESYSTEM_DISK=s3
AWS_ENDPOINT=
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
# Bucket privado (sin lectura pública) para documentos de verificación de vendedores.
VERIFICATION_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

# Confirmación de cuenta (opcional en local: sin esto el código sale en storage/logs)
RESEND_KEY=
RESEND_FROM=
# true = el registro exige el código enviado al correo (necesita dominio verificado en Resend)
EMAIL_VERIFICATION_REQUIRED=false
